{
  "name": "@nextdna/rtl-scout",
  "version": "0.1.0",
  "description": "Lint your Verilog/SystemVerilog in CI and get a cleanliness grade — a zero-dependency CLI wrapper around Verible. Modern lint-in-CI for hardware teams.",
  "keywords": [
    "verilog",
    "systemverilog",
    "rtl",
    "lint",
    "linter",
    "verible",
    "eda",
    "hardware",
    "ci",
    "fpga"
  ],
  "license": "MIT",
  "author": "Sandip Gami",
  "contributors": [
    "Sandip Gami"
  ],
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-dna/rtl-scout.git"
  },
  "bugs": {
    "url": "https://github.com/next-dna/rtl-scout/issues"
  },
  "homepage": "https://github.com/next-dna/rtl-scout#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "rtl-scout": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
